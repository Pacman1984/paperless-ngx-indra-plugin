# --- paperless-indra: optional settings for docker-compose.env ---------------
# Nothing is required: once installed, Indra replaces Tesseract for PDFs and
# images. Everything below shows the defaults.

#PAPERLESS_INDRA_ENABLED=true
#PAPERLESS_INDRA_SCORE=15          # > 10 beats Tesseract; < 20 lets a remote OCR plugin win
#PAPERLESS_INDRA_THREADS=2         # default: PAPERLESS_THREADS_PER_WORKER
#PAPERLESS_INDRA_DPI=200           # render resolution for OCR
#PAPERLESS_INDRA_MODE=auto         # auto (PDF text layer where sound, OCR elsewhere) | ocr | text
#PAPERLESS_INDRA_CONTENT_FORMAT=markdown   # markdown | text
#PAPERLESS_INDRA_TEXT_LAYER=true   # write invisible text layer into the archive PDF
#PAPERLESS_INDRA_PDFA=true         # PDF/A conversion per PAPERLESS_OCR_OUTPUT_TYPE (no Tesseract)
#PAPERLESS_INDRA_KEEP_FURNITURE=false  # keep page headers/footers in the Markdown
#PAPERLESS_INDRA_MATH=false        # LaTeX for formulas (extra models, slower)
#PAPERLESS_INDRA_MODEL_DIR=        # default: INDRA_OCR_MODEL_DIR (set by the custom image)
